    "def multiclass_confusion(y_true, y_pred, n_classes=3):\n",
    "    cm = np.zeros((n_classes, n_classes), dtype=int)\n",
    "    for t, p in zip(y_true, y_pred):\n",
    "        cm[t, p] += 1\n",
    "    return cm\n",
    "\n",
    "def macro_metrics(cm):\n",
    "    # per class: precision, recall, F1 from the confusion matrix; then average over classes\n",
    "    precs, recs, f1s = [], [], []\n",
    "    for c in range(cm.shape[0]):\n",
    "        TP = cm[c, c]; FP = cm[:, c].sum() - TP; FN = cm[c, :].sum() - TP\n",
    "        p = TP / (TP + FP) if TP + FP > 0 else 0.0\n",
    "        r = TP / (TP + FN) if TP + FN > 0 else 0.0\n",
    "        f = 2 * p * r / (p + r) if p + r > 0 else 0.0\n",
    "        precs.append(p); recs.append(r); f1s.append(f)\n",
    "    acc = np.trace(cm) / cm.sum()\n",
    "    return acc, np.mean(precs), np.mean(recs), np.mean(f1s)\n",
    "\n",
    "Xtr, ytr, Xte, yte = split_70_30(X_iris, y_iris)     # one fixed split for the matrices\n",
    "for k in ks:\n",
    "    _, preds = knn_accuracy(Xtr, ytr, Xte, yte, k)\n",
    "    cm = multiclass_confusion(yte, preds)\n",
    "    acc, p, r, f = macro_metrics(cm)\n",
    "    print(f\"k = {k}: confusion matrix (rows = true, columns = predicted)\")\n",
    "    print(cm)\n",
    "    print(f\"accuracy = {acc:.3f}, macro precision = {p:.3f}, macro recall = {r:.3f}, macro F1 = {f:.3f}\\n\")"
   ]
  },
